{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/landing",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/landing.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/home.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/shop/:slug",
        "destination": "/product/:slug",
        "type": 301
      },
      {
        "source": "/sa",
        "destination": "/sa/shop",
        "type": 302
      },
      {
        "source": "/sa/shop/:slug",
        "destination": "/sa/product/:slug",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/app",
        "destination": "/app/index.html"
      },
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/pregnancy",
        "destination": "/pregnancy.html"
      },
      {
        "source": "/pregnancy/**",
        "destination": "/pregnancy.html"
      },
      {
        "source": "/baby",
        "destination": "/baby.html"
      },
      {
        "source": "/baby/**",
        "destination": "/baby.html"
      },
      {
        "source": "/cycle",
        "destination": "/cycle.html"
      },
      {
        "source": "/fertility",
        "destination": "/fertility.html"
      },
      {
        "source": "/qadaa",
        "destination": "/qadaa.html"
      },
      {
        "source": "/fiqh",
        "destination": "/fiqh.html"
      },
      {
        "source": "/community",
        "destination": "/community.html"
      },
      {
        "source": "/community/**",
        "destination": "/community.html"
      },
      {
        "source": "/shop",
        "destination": "/shop.html"
      },
      {
        "source": "/shop/c/**",
        "destination": "/shop.html"
      },
      {
        "source": "/product/**",
        "destination": "/product.html"
      },
      {
        "source": "/cart",
        "destination": "/cart.html"
      },
      {
        "source": "/checkout",
        "destination": "/checkout.html"
      },
      {
        "source": "/sa/shop",
        "destination": "/shop.html"
      },
      {
        "source": "/sa/shop/c/**",
        "destination": "/shop.html"
      },
      {
        "source": "/sa/product/**",
        "destination": "/product.html"
      },
      {
        "source": "/sa/cart",
        "destination": "/cart.html"
      },
      {
        "source": "/sa/checkout",
        "destination": "/checkout.html"
      },
      {
        "source": "/account",
        "destination": "/account.html"
      },
      {
        "source": "/account/**",
        "destination": "/account.html"
      },
      {
        "source": "/login",
        "destination": "/login.html"
      },
      {
        "source": "/signup",
        "destination": "/login.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/admin/**",
        "destination": "/admin.html"
      },
      {
        "source": "/article",
        "destination": "/article.html"
      },
      {
        "source": "/article/**",
        "destination": "/article.html"
      },
      {
        "source": "/articles",
        "destination": "/articles.html"
      },
      {
        "source": "/articles/**",
        "destination": "/articles.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(), geolocation=(self), payment=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.gstatic.com https://apis.google.com https://www.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' blob: data: https://*.googleapis.com https://*.firebaseio.com https://*.firebaseapp.com https://*.cloudfunctions.net https://www.gstatic.com https://fonts.gstatic.com https://fonts.googleapis.com https://generativelanguage.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebaseinstallations.googleapis.com https://firebaselogging-pa.googleapis.com https://firebase.googleapis.com https://content-firebaseappcheck.googleapis.com https://firestore.googleapis.com https://storage.googleapis.com https://fcmregistrations.googleapis.com https://ipapi.co https://api.country.is https://ipinfo.io https://open.er-api.com https://api.exchangerate-api.com https://formspree.io wss://*.firebaseio.com; frame-src 'self' https://nabda-app-ca864.firebaseapp.com https://accounts.google.com https://appleid.apple.com https://*.facebook.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io"
          }
        ]
      },
      {
        "source": "/@(admin|admin.html|account|account.html|cart|cart.html|checkout|checkout.html|login|login.html)",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/@(admin|account)/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/data/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/@(index.html|app/index.html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/@(flutter_service_worker.js|app/flutter_service_worker.js|app/flutter_bootstrap.js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(woff|woff2|ttf|otf|png|jpg|jpeg|svg|webp|ico|wasm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/@(canvaskit|app/canvaskit)/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "nabda-app-ca864",
          "appId": "1:911912460091:android:aa9f2ec93356eb285b611e",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "nabda-app-ca864",
          "configurations": {
            "android": "1:911912460091:android:aa9f2ec93356eb285b611e",
            "ios": "1:911912460091:ios:2a36513a54eace8d5b611e",
            "web": "1:911912460091:web:a53336443c06b82d5b611e"
          }
        }
      }
    }
  }
}
